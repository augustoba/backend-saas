# /etc/saasweb/saasweb.env — variables del backend en producción.
# Copiar a /etc/saasweb/saasweb.env, completar y dejarlo legible sólo por root
# y el usuario del servicio:  chmod 640, chown root:saasweb.
# NUNCA subir este archivo con valores reales al repo.

# --- Base de datos (usuario dedicado, no root) ---
DB_URL=jdbc:mysql://127.0.0.1:3306/saasweb?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=saasweb
DB_PASSWORD=CAMBIAR

# --- Seguridad ---
# 32+ caracteres al azar:  openssl rand -base64 48
JWT_SECRET=CAMBIAR
JWT_EXPIRATION_MINUTES=720

# --- Plataforma ---
# Dominio raíz: cada tienda queda en <slug>.miplataforma.com
APP_PLATFORM_DOMAIN=miplataforma.com
APP_PLATFORM_SCHEME=https
# IP pública del VPS: un dominio propio se activa cuando su DNS apunta acá.
APP_PLATFORM_SERVER_IP=0.0.0.0
SERVER_PORT=8080
# Sólo desde la misma máquina: Caddy es el único que habla con el backend.
SERVER_ADDRESS=127.0.0.1

# URLs públicas (Mercado Pago avisa al webhook y vuelve al front).
BACKEND_PUBLIC_URL=https://miplataforma.com
FRONTEND_URL=https://miplataforma.com
CORS_ORIGINS=https://miplataforma.com

# --- Producción: sin datos de ejemplo ni selector de tienda demo ---
SEED_ENABLED=false
TENANT_DEMO_SWITCH_ENABLED=false

# --- Tienda piloto que se crea en el primer arranque y su admin ---
TENANT_SLUG=estilos-pequenos
TENANT_NAME=Estilos Pequeños
ADMIN_DNI=CAMBIAR
ADMIN_NOMBRE=CAMBIAR
ADMIN_APELLIDO=CAMBIAR
ADMIN_EMAIL=CAMBIAR
ADMIN_PASSWORD=CAMBIAR

# --- Superadmin (vos) ---
SUPERADMIN_DNI=CAMBIAR
SUPERADMIN_NOMBRE=CAMBIAR
SUPERADMIN_APELLIDO=CAMBIAR
SUPERADMIN_EMAIL=CAMBIAR
SUPERADMIN_PASSWORD=CAMBIAR

# --- Mail (Brevo SMTP) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=CAMBIAR
BREVO_SMTP_KEY=CAMBIAR
MARKETING_FROM_EMAIL=no-responder@miplataforma.com
